{
  "env": {
    "node": true,
    "es2022": true,
    "browser": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "plugins": ["security"],
  "extends": ["eslint:recommended", "plugin:security/recommended"],
  "rules": {
    "no-console": "warn",
    "security/detect-object-injection": "off",
    "security/detect-non-literal-fs-filename": "off",
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }]
  },
  "overrides": [
    {
      "files": ["script-*.js"],
      "parserOptions": {
        "sourceType": "script"
      },
      "globals": {
        "firebase": "readonly",
        "google": "readonly",
        "lucide": "readonly",
        "morphicons": "readonly",
        "bootstrap": "readonly"
      },
      "rules": {
        "no-undef": "off"
      }
    }
  ],
  "ignorePatterns": ["node_modules/", "dist/", ".next/", ".tsfrontend/"]
}

