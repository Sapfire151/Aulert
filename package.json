{
  "name": "aulert-api",
  "version": "1.0.0",
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "firebase-admin": "^10.3.0",
    "google-auth-library": "^9.0.0",
    "googleapis": "^173.0.0",
    "lucide": "^1.34.0",
    "morphicons": "^1.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vercel/node": "^9.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-plugin-security": "^1.7.1",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "lint": "eslint script-*.js --ext .js",
    "security:audit": "npm audit --audit-level=high",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.frontend.json && tsc --noEmit -p tsconfig.icons.json",
    "typecheck:api": "tsc --noEmit -p tsconfig.json",
    "typecheck:frontend": "tsc --noEmit -p tsconfig.frontend.json",
    "typecheck:icons": "tsc --noEmit -p tsconfig.icons.json",
    "build:frontend": "tsc -p tsconfig.frontend.build.json && node -e \"const fs=require('fs');['script-app','script-app-feedback','script-app-homework','script-app-settings','script-app-feed','script-app-calendar'].forEach(f=>{if(fs.existsSync('.tsfrontend/'+f+'.js'))fs.copyFileSync('.tsfrontend/'+f+'.js', f+'.js')})\"",
    "build:icons": "node scripts/build-icons.mjs",
    "build": "npm run build:frontend && npm run build:icons"
  },
  "allowScripts": {
    "@vercel/analytics@2.0.1": true,
    "esbuild@0.14.47": true,
    "esbuild@0.21.5": true
  }
}
