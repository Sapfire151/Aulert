{
  "compilerOptions": {
    "target": "ES2022",
    "module": "none",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": ".tsfrontend",
    "rootDir": "src/frontend",
    "types": [],
    "noEmit": true
  },
  "include": ["src/frontend/**/*.ts"],
  "exclude": ["src/frontend/**/*.tsx"]
}
